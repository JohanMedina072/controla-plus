generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementType {
  INCOME
  EXPENSE
}

enum ReminderType {
  CREDIT_CARD
  CREDIT
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  categories     Category[]
  paymentMethods PaymentMethod[]
  movements      Movement[]
  accounts       Account[]
  reminders      PaymentReminder[]
}

model Account {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  initialBalance Decimal  @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  userId String @db.Uuid

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements Movement[]

  @@unique([name, userId])
  @@unique([id, userId])
}

model PaymentReminder {
  id          String       @id @default(uuid()) @db.Uuid
  type        ReminderType
  name        String
  dueDay      Int
  nextDueDate DateTime     @db.Date
  amount      Decimal?     @db.Decimal(10, 2)
  isActive    Boolean      @default(true)
  lastPaidAt  DateTime?
  createdAt   DateTime     @default(now())

  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, nextDueDate])
}

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  type      MovementType
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements Movement[]

  @@unique([name, userId])
  @@unique([id, userId, type])
}

model PaymentMethod {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements Movement[]
  @@unique([name, userId])
  @@unique([id, userId])
}

model Movement {
  id          String       @id @default(uuid()) @db.Uuid
  type        MovementType
  amount      Decimal      @db.Decimal(10, 2)
  description String?
  date        DateTime     @default(now())

  userId          String  @db.Uuid
  categoryId      String  @db.Uuid
  paymentMethodId String  @db.Uuid
  accountId       String? @db.Uuid

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId, userId, type], references: [id, userId, type], onDelete: NoAction, onUpdate: NoAction, map: "Movement_category_owner_type_fkey")
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "Movement_payment_method_owner_fkey")
  account       Account?      @relation(fields: [accountId, userId], references: [id, userId], onDelete: NoAction, onUpdate: NoAction, map: "Movement_account_owner_fkey")
  @@index([userId, date])
  @@index([accountId, date])
}
